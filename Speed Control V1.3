--[========================================================--
--                  LÓGICA DE MOVIMIENTO Y SLIDER          --
--[========================================================--

local MIN_SPEED = 16
local MAX_SPEED = 500
local currentSpeed = MIN_SPEED
local isMinimized = false
local isDraggingSlider = false
local isDraggingWindow = false

local dragStartWindow
local startPosWindow

local function getHumanoid()
	local character = player.Character
	if character then
		return character:FindFirstChildOfClass("Humanoid")
	end
	return nil
end

local function applySpeed(speed)
	currentSpeed = speed
	speedInfoLabel.Text = "Velocidad: " .. math.floor(currentSpeed)
	
	local humanoid = getHumanoid()
	if humanoid then
		humanoid.WalkSpeed = currentSpeed
	end
end

local function updateSlider(inputPositionX)
	local absolutePosition = sliderBG.AbsolutePosition.X
	local absoluteSize = sliderBG.AbsoluteSize.X
	
	if absoluteSize <= 0 then return end
	
	local posRelative = math.clamp((inputPositionX - absolutePosition) / absoluteSize, 0, 1)
	local newSpeed = MIN_SPEED + (posRelative * (MAX_SPEED - MIN_SPEED))
	
	applySpeed(newSpeed)
	sliderFill.Size = UDim2.new(posRelative, 0, 1, 0)
	sliderKnob.Position = UDim2.new(posRelative, -8, 0.5, -8)
end

-- Lógica para arrastrar SOLO desde la barra de título
titleLabel.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingWindow = true
		dragStartWindow = input.Position
		startPosWindow = mainFrame.Position
	end
end)

-- Lógica del Slider
sliderBG.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = true
		updateSlider(input.Position.X)
	end
end)

-- Control global de entradas (Mouse / Táctil)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		isDraggingSlider = false
		isDraggingWindow = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		if isDraggingSlider then
			updateSlider(input.Position.X)
		elseif isDraggingWindow then
			local delta = input.Position - dragStartWindow
			mainFrame.Position = UDim2.new(
				startPosWindow.X.Scale, 
				startPosWindow.X.Offset + delta.X, 
				startPosWindow.Y.Scale, 
				startPosWindow.Y.Offset + delta.Y
			)
		end
	end
end)

-- Botón de Reset
resetBtn.MouseButton1Click:Connect(function()
	applySpeed(MIN_SPEED)
	sliderFill.Size = UDim2.new(0, 0, 1, 0)
	sliderKnob.Position = UDim2.new(0, -8, 0.5, -8)
end)

-- Botón de Minimizar
minimizeBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	
	if isMinimized then
		minimizeBtn.Text = "+"
		contentContainer.Visible = false
		mainFrame:TweenSize(UDim2.new(0, 260, 0, 35), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true)
	else
		minimizeBtn.Text = "-"
		mainFrame:TweenSize(UDim2.new(0, 260, 0, 160), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.2, true, function()
			contentContainer.Visible = true
		end)
	end
end)

player.CharacterAdded:Connect(function(char)
	local humanoid = char:WaitForChild("Humanoid")
	humanoid.WalkSpeed = currentSpeed
end)
